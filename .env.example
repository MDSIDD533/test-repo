# Public market data (no API key required for Binance public endpoints)
BINANCE_BASE_URL=https://api.binance.com
DEFAULT_TIMEFRAME=5m

# Paper trading (never live execution)
PAPER_STARTING_BALANCE=1000
PAPER_RISK_PERCENT=1
PAPER_MAX_OPEN_TRADES=5
PAPER_FEE_PERCENT=0.1
PAPER_SLIPPAGE_PERCENT=0
PAPER_MIN_REWARD_RISK=1.5
PAPER_MAX_ATR_PCT=6
PAPER_MIN_CALIBRATED_PROBABILITY=0.55

# Safety invariant; there is no code path that submits exchange orders.
LIVE_TRADING_ENABLED=false

# Append-only forecast ledger. Defaults to runtime/forecast_ledger.jsonl,
# which is git-ignored. Point this at durable storage in a real deployment.
# FORECAST_LEDGER_PATH=/absolute/path/forecast_ledger.jsonl
